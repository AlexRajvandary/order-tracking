# PostgreSQL
POSTGRES_DB=ordertracking
POSTGRES_USER=ordertracking
POSTGRES_PASSWORD=ordertracking
POSTGRES_PORT=5433

# API
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
APP_BASE_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080

# JWT
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_MIN_32_CHARS_LONG
JWT_ISSUER=ordertracking
JWT_AUDIENCE=ordertracking-admin
JWT_ACCESS_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_DAYS=7

# Seed (first run only)
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=admin

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=order-tracking

# OpenAI (AI order draft parse — server-side only)
# Create key at https://platform.openai.com/api-keys (API billing, not ChatGPT Plus)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TRANSLATION_OPENAI_MODEL=gpt-5-mini

# Fornex VPS monitoring (server-side only)
FORNEX_API_KEY=
FORNEX_ORDER_ID=

# Products microservice
PRODUCTS_DB=products
PRODUCTS_USER=products
PRODUCTS_PASSWORD=products
PRODUCTS_POSTGRES_PORT=5434
PRODUCTS_API_PORT=5281

# Crawler queue service key (use a long random value in production)
CRAWLER_API_KEY=dev-crawler-key-change-me
CRAWLER_POLL_INTERVAL_MS=5000
CRAWLER_BATCH_SIZE=50
CRAWLER_PAGE_DELAY_MS=1000
CRAWLER_PAGE_TIMEOUT_MS=60000
TRANSLATION_POLL_INTERVAL_SECONDS=5
TRANSLATION_MAX_RETRIES=3
TRANSLATION_RETRY_BASE_DELAY_SECONDS=2
