www.the-get.ru {
	redir https://the-get.ru{uri} permanent
}

the-get.ru {
	encode zstd gzip
	handle /api/catalog-* {
		reverse_proxy catalog:3000
	}
	handle /api/catalog/* {
		reverse_proxy catalog:3000
	}
	handle /api/individual-requests {
		reverse_proxy catalog:3000
	}
	handle /api/auction-requests {
		reverse_proxy catalog:3000
	}
	handle /api/ticket-requests {
		reverse_proxy catalog:3000
	}
	handle /api/products* {
		reverse_proxy products-api:8080
	}
	handle /api* {
		reverse_proxy api:8080
	}
	handle /hubs* {
		reverse_proxy api:8080
	}
	handle /health* {
		respond 404
	}
	handle /track {
		redir https://tracking.the-get.ru permanent
	}
	handle_path /track/* {
		redir https://tracking.the-get.ru{uri} permanent
	}
	handle {
		reverse_proxy catalog:3000
	}
}

admin.the-get.ru {
	encode zstd gzip
	handle /track* {
		respond 404
	}
	handle /tracking* {
		respond 404
	}
	handle /api/products* {
		reverse_proxy products-api:8080
	}
	handle /api/admin/translation-jobs* {
		reverse_proxy products-api:8080
	}
	handle /api/translation-jobs* {
		reverse_proxy products-api:8080
	}
	handle /api/internal/products* {
		reverse_proxy products-api:8080
	}
	handle /api* {
		reverse_proxy api:8080
	}
	handle /hubs* {
		reverse_proxy api:8080
	}
	handle /health* {
		respond 404
	}
	handle {
		reverse_proxy api:8080
	}
}

api.the-get.ru {
	encode zstd gzip
	handle /track* {
		respond 404
	}
	handle /tracking* {
		respond 404
	}
	handle /api/products* {
		reverse_proxy products-api:8080
	}
	handle /api/admin/translation-jobs* {
		reverse_proxy products-api:8080
	}
	handle /api/translation-jobs* {
		reverse_proxy products-api:8080
	}
	handle /api/internal/products* {
		reverse_proxy products-api:8080
	}
	handle /api* {
		reverse_proxy api:8080
	}
	handle /hubs* {
		reverse_proxy api:8080
	}
	handle /health* {
		respond 404
	}
	handle {
		reverse_proxy api:8080
	}
}

tracking.the-get.ru {
	encode zstd gzip
	handle /api/v1/track* {
		reverse_proxy api:8080
	}
	handle /api/v1/attachments/* {
		reverse_proxy api:8080
	}
	handle /hubs/tracking* {
		reverse_proxy api:8080
	}
	handle /assets* {
		reverse_proxy api:8080
	}
	handle /favicon.svg {
		reverse_proxy api:8080
	}
	handle /favicon.ico {
		reverse_proxy api:8080
	}
	handle / {
		reverse_proxy api:8080
	}
	@trackingCode path_regexp trackingCode ^/[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{5}/?$
	handle @trackingCode {
		reverse_proxy api:8080
	}
	handle {
		respond 404
	}
}

