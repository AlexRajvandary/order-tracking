		import products_upstream
	}
	handle /api/translation-jobs* {
		import products_upstream
	}
	handle /api/internal/products* {
		import products_upstream
	}
	handle /api* {
		import api_upstream
	}
	handle /hubs* {
		import api_upstream
	}
	handle /health* {
		respond 404
	}
	handle {
		import api_upstream
	}
}

api.the-get.ru {
	encode zstd gzip
	handle /metrics {
		respond 404
