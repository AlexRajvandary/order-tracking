tracking.the-get.ru {
	encode zstd gzip
	handle /metrics {
		respond 404
	}
	handle /api/v1/track* {
		import api_upstream
	}
	handle /api/v1/attachments/* {
		import api_upstream
	}
	handle /hubs/tracking* {
		import api_upstream
	}
	handle /assets* {
		import api_upstream
	}
	handle /favicon.svg {
		import api_upstream
	}
	handle /favicon.ico {
		import api_upstream
	}
	handle / {
		import api_upstream
	}
	@trackingCode path_regexp trackingCode ^/[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{5}/?$
	handle @trackingCode {
		import api_upstream
	}
	handle {
		respond 404
	}
}

