(api_upstream) {
	reverse_proxy api:8080 {
		lb_try_duration 10s
		lb_try_interval 500ms
	}
}

(catalog_upstream) {
	reverse_proxy catalog:3000 {
		lb_try_duration 10s
		lb_try_interval 500ms
	}
}

(products_upstream) {
	reverse_proxy products-api:8080 {
		lb_try_duration 10s
		lb_try_interval 500ms
	}
}

www.the-get.ru {
	redir https://the-get.ru{uri} permanent
}

the-get.ru {
	encode zstd gzip
	handle /metrics {
		respond 404
	}
	handle /sitemap.xml {
		import products_upstream
	}
	handle /sitemaps/* {
		import products_upstream
	}
	handle /api/internal/sitemap* {
		import products_upstream
	}
	handle /api/catalog-* {
		import catalog_upstream
	}
	handle /api/catalog/* {
		import catalog_upstream
	}
	handle /api/individual-requests {
		import catalog_upstream
	}
	handle /api/find-product-requests {
		import catalog_upstream
	}
	handle /api/auction-requests {
		import catalog_upstream
	}
	handle /api/ticket-requests {
		import catalog_upstream
	}
	handle /api/products* {
		import products_upstream
	}
	handle /api* {
		import api_upstream
	}
	handle /hubs* {
		import api_upstream
	}
	handle /health* {
		respond 404
	}
	handle /track {
		redir https://tracking.the-get.ru permanent
	}
	handle_path /track/* {
		redir https://tracking.the-get.ru{uri} permanent
	}
	handle {
		import catalog_upstream
	}
}

