        <mxCell id="te6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="t6" target="t7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="te7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="t7" target="t8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="te8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="t8" target="t9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="te9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="t9" target="t10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="te10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="t10" target="t11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="te11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="t11" target="t12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="te12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="t12" target="t13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="te13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="t13" target="t14"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="te14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="t14" target="t15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="te15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="t15" target="t16"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="te16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="t16" target="t17"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="te17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="t17" target="t18"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="te18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="t18" target="t19"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="te19" value="Общий или подробный вид" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="t19" target="t20"><mxGeometry relative="1" as="geometry"/></mxCell>
