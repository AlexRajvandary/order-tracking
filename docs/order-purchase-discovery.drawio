  </diagram>

  <diagram id="domain-model" name="03 Концептуальная модель">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="d-title" value="Концептуальная модель: заказ, закупки и три уровня доставки" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1000" height="40" as="geometry"/></mxCell>

        <mxCell id="d-order" value="&lt;b&gt;Заказ&lt;/b&gt;&lt;br&gt;Публичный трек-номер&lt;br&gt;Общий публичный статус&lt;br&gt;Детализация включена: да/нет" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="90" y="170" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="d-line" value="&lt;b&gt;Позиция заказа&lt;/b&gt;&lt;br&gt;Товар, количество&lt;br&gt;Цвет, размер, пожелания&lt;br&gt;Сводный прогресс" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="450" y="170" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="d-task" value="&lt;b&gt;Задание на выкуп&lt;/b&gt;&lt;br&gt;Магазин&lt;br&gt;Назначенный выкупщик&lt;br&gt;Рабочий статус" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="810" y="100" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="d-allocation" value="&lt;b&gt;Позиция закупки&lt;/b&gt;&lt;br&gt;Связь с позицией заказа&lt;br&gt;Количество&lt;br&gt;Результат выкупа&lt;br&gt;Фактическая цена" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="810" y="290" width="230" height="140" as="geometry"/></mxCell>
        <mxCell id="d-purchase" value="&lt;b&gt;Закупка&lt;/b&gt;&lt;br&gt;Фактическая транзакция&lt;br&gt;Магазин, дата, сумма&lt;br&gt;Одна или несколько позиций" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1170" y="170" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="d-receipt" value="&lt;b&gt;Чек&lt;/b&gt;&lt;br&gt;Файл / фотография&lt;br&gt;Сумма, валюта, дата&lt;br&gt;Кто загрузил" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1170" y="370" width="230" height="115" as="geometry"/></mxCell>

        <mxCell id="d-store-shipment" value="&lt;b&gt;Отправление магазина&lt;/b&gt;&lt;br&gt;Магазин → выкупщик&lt;br&gt;Трек перевозчика (опционально)&lt;br&gt;Статус доставки" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1530" y="100" width="250" height="125" as="geometry"/></mxCell>
        <mxCell id="d-receipt-line" value="&lt;b&gt;Результат приёмки позиции&lt;/b&gt;&lt;br&gt;Получена / отсутствует&lt;br&gt;Неверная / повреждена&lt;br&gt;Не удалось сопоставить" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1530" y="300" width="250" height="125" as="geometry"/></mxCell>
        <mxCell id="d-intl" value="&lt;b&gt;Международная посылка&lt;/b&gt;&lt;br&gt;Япония → Москва&lt;br&gt;Ответственный&lt;br&gt;Состав, трек и статус" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1910" y="100" width="250" height="125" as="geometry"/></mxCell>
        <mxCell id="d-final" value="&lt;b&gt;Клиентское отправление&lt;/b&gt;&lt;br&gt;Админ → покупатель&lt;br&gt;Состав, трек и статус" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="2290" y="100" width="230" height="110" as="geometry"/></mxCell>

        <mxCell id="d-rule1" value="&lt;b&gt;Правило 1&lt;/b&gt;&lt;br&gt;Один заказ может участвовать в нескольких закупках. Одна закупка может содержать позиции нескольких заказов." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="90" y="600" width="360" height="120" as="geometry"/></mxCell>
        <mxCell id="d-rule2" value="&lt;b&gt;Правило 2&lt;/b&gt;&lt;br&gt;Статус выкупа хранится по позиции закупки. Чек относится к закупке, а не к статусу заказа." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="500" y="600" width="360" height="120" as="geometry"/></mxCell>
        <mxCell id="d-rule3" value="&lt;b&gt;Правило 3&lt;/b&gt;&lt;br&gt;Статус доставки хранится у конкретного отправления. Результат приёмки фиксируется отдельно по товарам." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="910" y="600" width="360" height="120" as="geometry"/></mxCell>
        <mxCell id="d-rule4" value="&lt;b&gt;Правило 4&lt;/b&gt;&lt;br&gt;Публичный статус заказа рассчитывается из внутренних состояний. Подробности видны покупателю только если их включил админ." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1320" y="600" width="380" height="120" as="geometry"/></mxCell>
        <mxCell id="d-rule5" value="&lt;b&gt;Ограничение&lt;/b&gt;&lt;br&gt;Маркировка входящих товаров различается по магазинам. Идентификаторы магазина и трек доставки могут отсутствовать; нужна ручная сверка." style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1750" y="600" width="390" height="120" as="geometry"/></mxCell>

        <mxCell id="d-status1" value="&lt;b&gt;Жизненный цикл позиции выкупа&lt;/b&gt;&lt;br&gt;Ожидает → В работе → Выкуплена&lt;br&gt;↘ Не удалось выкупить / Отменена" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="220" y="850" width="360" height="120" as="geometry"/></mxCell>
        <mxCell id="d-status2" value="&lt;b&gt;Жизненный цикл отправления&lt;/b&gt;&lt;br&gt;Черновик → Комплектуется → Упаковано&lt;br&gt;→ Передано перевозчику → В пути&lt;br&gt;→ Получено → Содержимое проверено" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="720" y="835" width="410" height="150" as="geometry"/></mxCell>
        <mxCell id="d-status3" value="&lt;b&gt;Приёмка товара&lt;/b&gt;&lt;br&gt;Ожидается → Получен&lt;br&gt;↘ Отсутствует / Неверный / Повреждён / Не сопоставлен" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1280" y="850" width="400" height="120" as="geometry"/></mxCell>
        <mxCell id="d-open" value="&lt;b&gt;Открытые вопросы для следующей сессии&lt;/b&gt;&lt;br&gt;• Кто и по каким правилам группирует позиции в задания?&lt;br&gt;• Можно ли делить количество одной позиции между закупками?&lt;br&gt;• Кто создаёт и закрывает международную посылку в каждом сценарии?&lt;br&gt;• Какие статусы и формулировки показываются покупателю?&lt;br&gt;• Где проходит граница MVP?" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1840" y="820" width="600" height="190" as="geometry"/></mxCell>

        <mxCell id="de1" value="1 → N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="d-order" target="d-line"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de2" value="N ↔ N через позицию закупки" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="d-line" target="d-allocation"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de3" value="содержит" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="d-task" target="d-allocation"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de4" value="реализуется закупкой" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="d-allocation" target="d-purchase"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de5" value="0..N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="d-purchase" target="d-receipt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de6" value="1 → N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="d-purchase" target="d-store-shipment"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de7" value="приёмка содержимого" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="d-store-shipment" target="d-receipt-line"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de8" value="консолидируется в" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="d-receipt-line" target="d-intl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="de9" value="после приёмки разделяется на" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="d-intl" target="d-final"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
