# Copy this file to .env on the VPS and fill in real values.
# Do NOT commit the real .env.

# --- Public addresses ---
PUBLIC_BASE_URL=https://the-get.ru
WWW_BASE_URL=https://www.the-get.ru
ADMIN_BASE_URL=https://admin.the-get.ru
API_BASE_URL=https://api.the-get.ru
# Keep temporarily while validating the new domains; remove with the legacy Caddy block later.
LEGACY_SITE_ADDRESS=89-127-208-99.sslip.io

# --- PostgreSQL ---
POSTGRES_DB=ordertracking
POSTGRES_USER=ordertracking
POSTGRES_PASSWORD=change_me_strong_password

# --- JWT (min 32 characters) ---
JWT_SECRET=change_me_to_a_random_string_at_least_32_chars

# --- MinIO ---
MINIO_ROOT_USER=change_me_minio_user
MINIO_ROOT_PASSWORD=change_me_strong_password

# --- OpenAI (AI-assisted create order) ---
# platform.openai.com API key — not ChatGPT Plus. Leave empty to disable AI parse.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TRANSLATION_OPENAI_MODEL=gpt-5-mini

# --- Fornex VPS monitoring (server-side only) ---
# Order number includes the 34- prefix.
FORNEX_API_KEY=
FORNEX_ORDER_ID=

# --- First admin (seeded on empty DB) ---
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=change_me_admin_password

# --- Products microservice (separate Postgres) ---
PRODUCTS_DB=products
PRODUCTS_USER=products
PRODUCTS_PASSWORD=change_me_strong_products_password

# --- Telegram Login Widget + admin bot (BotFather) ---
# Leave empty to disable Telegram login / bind / bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Optional secret for X-Telegram-Bot-Api-Secret-Token on /api/bot/webhook
TELEGRAM_WEBHOOK_SECRET=
CRAWLER_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_CRAWLER_KEY
CRAWLER_POLL_INTERVAL_MS=5000
CRAWLER_BATCH_SIZE=50
CRAWLER_PAGE_DELAY_MS=1000
CRAWLER_PAGE_TIMEOUT_MS=60000
TRANSLATION_POLL_INTERVAL_SECONDS=5
TRANSLATION_MAX_RETRIES=3
TRANSLATION_RETRY_BASE_DELAY_SECONDS=2
